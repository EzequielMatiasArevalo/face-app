# Copiar a .env.local y completar con la config de la app web de Firebase:
#   firebase apps:sdkconfig WEB <APP_ID> --project eleven-analytics-agents
# Se incrusta en el bundle al hacer `next build` (también al construir la imagen de Docker).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eleven-analytics-agents.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eleven-analytics-agents
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL del backend FastAPI tal como la ve el navegador
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Opcional, solo desarrollo: usar el emulador de Firebase Auth (firebase emulators:start --only auth)
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
