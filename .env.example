# Valores propios de cada despliegue (proyecto de Google Cloud, bucket, Firebase, admins).
# Copiá este archivo a .env (no se versiona) o exportá las variables en la shell:
#   - docker compose lee ./.env automáticamente (lo exportado en la shell tiene prioridad)
#   - sin Docker, cargalas antes de iniciar backend o frontend:  set -a; . ./.env; set +a

# Proyecto de Google Cloud: Firebase Auth y bucket
GCP_PROJECT_ID=

# Bucket privado para imágenes y resultados
GCS_BUCKET=

# Service account con roles/storage.objectUser sobre el bucket, que el backend impersona con
# las credenciales de gcloud (vacío: usar las credenciales directamente)
GCS_SERVICE_ACCOUNT=

# Emails (verificados) que siempre son administradores, separados por coma
ADMIN_EMAILS=

# App web de Firebase:  firebase apps:sdkconfig WEB <APP_ID> --project "$GCP_PROJECT_ID"
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# Opcionales
# Proyecto de Firebase, si no es GCP_PROJECT_ID (por ejemplo demo-face-app con el emulador)
# FIREBASE_PROJECT_ID=
# Dominio de Auth (por defecto <FIREBASE_PROJECT_ID o GCP_PROJECT_ID>.firebaseapp.com)
# FIREBASE_AUTH_DOMAIN=
# URL del backend tal como la ve el navegador
# BACKEND_PUBLIC_URL=http://localhost:8000

# Solo desarrollo sin Docker: usar el emulador de Firebase Auth en frontend y backend (con
# FIREBASE_PROJECT_ID=demo-...). Nunca en un backend real: acepta tokens sin firmar.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
