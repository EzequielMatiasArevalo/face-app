# La configuración del frontend sale de las variables del proyecto definidas en ../.env.example
# (GCP_PROJECT_ID, FIREBASE_API_KEY, FIREBASE_APP_ID y opcionales). Para `npm run dev`, exportalas
# antes (set -a; . ../.env; set +a) o copiá este archivo a .env.local y completalas acá.
GCP_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_DOMAIN=
# BACKEND_PUBLIC_URL=http://localhost:8000
# Solo desarrollo: emulador de Firebase Auth
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
