APP_NAME=Facial Recognition TP1
MODEL_NAME=glintr100.onnx
SIMILARITY_METRIC=cosine
SIMILARITY_THRESHOLD=0.4
EMBEDDINGS_PATH=data/embeddings.json
DATA_PATH=data
OUTPUT_PATH=output
CORS_ORIGINS="http://localhost:3000"
# GCP_PROJECT_ID, GCS_BUCKET, GCS_SERVICE_ACCOUNT, ADMIN_EMAILS y FIREBASE_PROJECT_ID son propios de cada
# despliegue: se exportan en la shell o se definen en ./.env (ver .env.example en la raíz y el README).
# Imágenes: "gcs" (bucket) o "local" (carpeta OUTPUT_PATH, para desarrollo sin GCP)
STORAGE_BACKEND=gcs
# Prefijo opcional para aislar entornos dentro del bucket (ej. dev/)
STORAGE_PREFIX=
MAX_UPLOAD_MB=15
MODEL_PATH=models
# Detector SCRFD-10GF con keypoints + reconocedor ArcFace R100@Glint360K (InsightFace antelopev2)
DETECTOR_MODEL_NAME=scrfd_10g_bnkps.onnx
DET_SCORE_THRESHOLD=0.4
DET_INPUT_SIZE=640
MIN_FACE_SIZE=20
ALIGN_MARGIN=0.5
# Registro con 4 fotos: pose estimada con landmarks 3D (1k3d68, antelopev2)
POSE_MODEL_NAME=1k3d68.onnx
# Giro máximo (grados) para aceptar una foto como frontal y mínimo para aceptarla como perfil
FRONTAL_MAX_YAW=20
PROFILE_MIN_YAW=45
# El rostro de la frontal de cerca debe ser al menos este factor más alto que el de la de lejos
CLOSE_FAR_MIN_RATIO=1.3
# Similitud coseno mínima de cada foto contra la frontal de cerca (misma persona)
REGISTRATION_MIN_SIMILARITY=0.3
# Imágenes generadas/alteradas con IA: metadatos C2PA/IPTC + clasificador Community Forensics (ViT-S 384).
# Si la probabilidad del modelo es >= umbral, la imagen se marca como IA y no se corre la detección de rostros.
AI_DETECTOR_MODEL_NAME=community_forensics_vit_s384.onnx
AI_DETECTION_THRESHOLD=0.9
MAX_WORKERS=2
FACE_SIZE=112
# Must match your face embedding model Example: (InsightFace ArcFace is usually 512).
EMBEDDING_DIM=512

# PostgreSQL / pgvector (future integration)
USE_PGVECTOR=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=faces
POSTGRES_USER=faces_user
POSTGRES_PASSWORD=faces_pass
